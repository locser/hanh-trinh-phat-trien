{
	"name": "course",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"grpc:client": "protoc --plugin=./node_modules/.bin/protoc-gen-ts.cmd --ts_proto_out=./ --ts_proto_opt=addGrpcMetadata=true --ts_proto_opt=nestJs=true,snakeToCamel=false ./src/grpc/client/protos/*.proto",
		"grpc:server": "protoc --plugin=./node_modules/.bin/protoc-gen-ts.cmd --ts_proto_out=./ --ts_proto_opt=addGrpcMetadata=true --ts_proto_opt=nestJs=true,snakeToCamel=false ./src/grpc/server/protos/*.proto",
		"migration:generate": "typeorm-ts-node-commonjs migration:generate -d ormconfig.ts",
		"migration:single": "bash scripts/single-table-migration.sh",
		"migration:extract-sql": "bash scripts/extract-sql.sh"
	},
	"dependencies": {
		"@grpc/grpc-js": "^1.12.3",
		"@grpc/proto-loader": "^0.7.13",
		"@nestjs-modules/ioredis": "^2.0.2",
		"@nestjs/axios": "^3.1.3",
		"@nestjs/bull": "^11.0.2",
		"@nestjs/common": "^10.0.0",
		"@nestjs/core": "^10.0.0",
		"@nestjs/event-emitter": "^3.0.1",
		"@nestjs/jwt": "^11.0.0",
		"@nestjs/microservices": "^10.4.12",
		"@nestjs/platform-express": "^10.0.0",
		"@nestjs/schedule": "^5.0.1",
		"@nestjs/swagger": "^8.0.7",
		"@nestjs/throttler": "^6.4.0",
		"@nestjs/typeorm": "^10.0.2",
		"@types/bcrypt": "^6.0.0",
		"axios": "^1.7.9",
		"bcrypt": "^6.0.0",
		"bullmq": "^5.53.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"cron": "^4.3.2",
		"dotenv": "^16.4.5",
		"google-auth-library": "^10.3.0",
		"handlebars": "^4.7.8",
		"ioredis": "^5.4.1",
		"jest-junit": "^16.0.0",
		"kafkajs": "^2.2.4",
		"moment-timezone": "^0.5.46",
		"mysql2": "^3.11.5",
		"reflect-metadata": "^0.1.13",
		"rxjs": "^7.8.1",
		"typeorm": "^0.3.20"
	},
	"devDependencies": {
		"@nestjs/cli": "^10.0.0",
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"@types/express": "^4.17.17",
		"@types/jest": "^29.5.2",
		"@types/node": "^20.3.1",
		"@types/supertest": "^2.0.12",
		"eslint-config-prettier": "^9.0.0",
		"eslint-plugin-prettier": "^5.0.0",
		"jest": "^29.5.0",
		"prettier": "^3.0.0",
		"source-map-support": "^0.5.21",
		"supertest": "^6.3.3",
		"ts-jest": "^29.1.0",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.1",
		"ts-proto": "^2.5.1",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.1.3"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"roots": [
			"<rootDir>/src",
			"<rootDir>/test"
		],
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"src/**/*.ts",
			"!src/**/*.controller.ts",
			"!src/**/*.dto.ts",
			"!src/**/*.module.ts",
			"!src/**/*.schema.ts",
			"!src/**/*.entity.ts",
			"!src/**/*.config.ts",
			"!src/**/*.response.ts"
		],
		"coverageDirectory": "./coverage",
		"testEnvironment": "node",
		"testPathIgnorePatterns": [
			"/node_modules/",
			"/dist/",
			".*\\.controller\\.ts$",
			".*\\.dto\\.ts$",
			".*\\.module\\.ts$",
			".*\\.schema\\.ts$",
			".*\\.entity\\.ts$",
			".*\\.config\\.ts$",
			".*\\.response\\.ts$"
		],
		"reporters": [
			"default",
			[
				"jest-junit",
				{
					"outputDirectory": "./coverage/junit",
					"outputName": "results.xml"
				}
			]
		]
	}
}
